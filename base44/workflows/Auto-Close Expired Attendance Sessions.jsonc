{
  "name": "Auto-Close Expired Attendance Sessions",
  "description": "Hourly job that closes open attendance sessions whose assigned shift has ended + buffer. Marks them as Missing Check-out, preserving all recorded punches. Releases employees for their next scheduled shift.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Qatar",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_close_expired_attendance",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCloseAttendance",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}