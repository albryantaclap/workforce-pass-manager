{
  "name": "AttendanceRecord",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string",
      "description": "Linked Employee record ID (Master List identity)"
    },
    "employee_name": {
      "type": "string",
      "description": "Employee full name (denormalized for display only)"
    },
    "company": {
      "type": "string",
      "description": "Employee company (denormalized for display only)"
    },
    "attendance_date": {
      "type": "string",
      "format": "date",
      "description": "The attendance date (YYYY-MM-DD). One open session per personnel per date."
    },
    "check_in_at": {
      "type": "string",
      "format": "date-time",
      "description": "Check-in timestamp (ISO). Empty string while no session exists."
    },
    "check_out_at": {
      "type": "string",
      "format": "date-time",
      "description": "Check-out timestamp (ISO). Empty while the session is still open."
    },
    "duration_minutes": {
      "type": "number",
      "description": "Total stay duration in minutes (calculated on check-out)",
      "default": 0
    },
    "work_location": {
      "type": "string",
      "description": "Work location at the time of check-in (preserved historically)"
    },
    "checked_in_by": {
      "type": "string",
      "description": "Email of the authenticated user who performed check-in"
    },
    "checked_in_by_name": {
      "type": "string",
      "description": "Display name of the user who performed check-in"
    },
    "checked_out_by": {
      "type": "string",
      "description": "Email of the authenticated user who performed check-out"
    },
    "checked_out_by_name": {
      "type": "string",
      "description": "Display name of the user who performed check-out"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "completed"
      ],
      "default": "open",
      "description": "Attendance session status: open (checked in, not out) or completed"
    },
    "source_page": {
      "type": "string",
      "default": "COMO Camp",
      "description": "Page where the attendance was recorded"
    }
  },
  "required": [
    "personnel_id",
    "attendance_date",
    "check_in_at",
    "status"
  ]
}