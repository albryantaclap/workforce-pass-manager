{
  "name": "AttendanceRecord",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string",
      "description": "Linked Employee record ID (Master List identity)"
    },
    "employee_name": {
      "type": "string",
      "description": "Employee full name (denormalized for display only)"
    },
    "company": {
      "type": "string",
      "description": "Employee company (denormalized for display only)"
    },
    "attendance_date": {
      "type": "string",
      "format": "date",
      "description": "The attendance date (YYYY-MM-DD). Determined by the assigned shift/session date, not calendar midnight, to support cross-midnight shifts."
    },
    "check_in_at": {
      "type": "string",
      "format": "date-time",
      "description": "First/earliest clock-in timestamp (ISO). Kept in sync with first_in_at for backward compatibility with COMO Camp and Master List. Empty string while no session exists."
    },
    "check_out_at": {
      "type": "string",
      "format": "date-time",
      "description": "Latest clock-out timestamp (ISO). Kept in sync with final_out_at for backward compatibility. Empty while the session is still open."
    },
    "first_in_at": {
      "type": "string",
      "format": "date-time",
      "description": "First Punch In timestamp (ISO) \u2014 earliest clock-in for the day"
    },
    "first_out_at": {
      "type": "string",
      "format": "date-time",
      "description": "First Punch Out timestamp (ISO) \u2014 first clock-out"
    },
    "second_in_at": {
      "type": "string",
      "format": "date-time",
      "description": "Second Punch In timestamp (ISO) \u2014 clock-in after break"
    },
    "final_out_at": {
      "type": "string",
      "format": "date-time",
      "description": "Final Punch Out timestamp (ISO) \u2014 latest clock-out for the day"
    },
    "first_in_by_user_id": {
      "type": "string",
      "description": "Authenticated account (User record id) that performed the First Punch In. Permanent reference \u2014 the display name is resolved from the User record, so renaming an account never rewrites history. Empty when the punch was never attributed (legacy rows)."
    },
    "first_out_by_user_id": {
      "type": "string",
      "description": "Authenticated account (User record id) that performed the First Punch Out (break start)."
    },
    "second_in_by_user_id": {
      "type": "string",
      "description": "Authenticated account (User record id) that performed the Second Punch In (return from break)."
    },
    "final_out_by_user_id": {
      "type": "string",
      "description": "Authenticated account (User record id) that performed the Final Punch Out."
    },
    "duration_minutes": {
      "type": "number",
      "description": "Total working duration in minutes (sum of completed IN\u2192OUT pairs, minus break if configured)",
      "default": 0
    },
    "overtime_minutes": {
      "type": "number",
      "description": "Overtime duration in minutes (working time beyond overtime_start_hours)",
      "default": 0
    },
    "work_location": {
      "type": "string",
      "description": "Work location / branch at the time of check-in (preserved historically)"
    },
    "checked_in_by": {
      "type": "string",
      "description": "Email of the authenticated user who performed the first check-in"
    },
    "checked_in_by_name": {
      "type": "string",
      "description": "Display name of the user who performed the first check-in"
    },
    "checked_out_by": {
      "type": "string",
      "description": "Email of the authenticated user who performed the final check-out"
    },
    "checked_out_by_name": {
      "type": "string",
      "description": "Display name of the user who performed the final check-out"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "completed"
      ],
      "default": "open",
      "description": "Attendance session status: open (checked in, not fully checked out) or completed (final out recorded or auto-closed)"
    },
    "attendance_status": {
      "type": "string",
      "enum": [
        "Present",
        "Absent",
        "Late",
        "Half Day",
        "On Leave",
        "Rest Day",
        "Holiday",
        "Missing Check-out",
        "Incomplete",
        "Not Checked In",
        "First In Completed",
        "First Out Completed",
        "Second In Completed",
        "Manual Override"
      ],
      "description": "Effective attendance status. Equals manual_status_override when set, otherwise the system-calculated status."
    },
    "calculated_status": {
      "type": "string",
      "description": "System-calculated attendance status derived from punches and shift rules (audit trail; never overwritten by a manual override)."
    },
    "manual_status_override": {
      "type": "string",
      "description": "Manual status override set by an admin. When non-empty, the effective status (attendance_status) reflects this value while calculated_status preserves the system calculation."
    },
    "manual_status_reason": {
      "type": "string",
      "description": "Reason recorded when an admin sets a manual status override"
    },
    "is_late": {
      "type": "boolean",
      "default": false,
      "description": "Whether the first clock-in was after shift start + grace period"
    },
    "late_minutes": {
      "type": "number",
      "default": 0,
      "description": "Minutes late beyond the grace period"
    },
    "shift_id": {
      "type": "string",
      "description": "Linked AttendanceShift record ID (the shift assigned to this employee for this day)"
    },
    "shift_name": {
      "type": "string",
      "description": "Shift name (denormalized for display)"
    },
    "source_page": {
      "type": "string",
      "default": "COMO Camp",
      "description": "Page where the attendance was originally recorded"
    },
    "source": {
      "type": "string",
      "enum": [
        "Manual",
        "COMO Camp",
        "Employee Portal",
        "ID Card Scanner",
        "Biometric Device",
        "Admin Entry",
        "Imported",
        "API"
      ],
      "description": "Source of the attendance record"
    },
    "is_manual": {
      "type": "boolean",
      "default": false,
      "description": "Whether this record was created via manual entry"
    },
    "manual_reason": {
      "type": "string",
      "description": "Reason provided for manual entry/correction"
    },
    "last_edited_by_user_id": {
      "type": "string",
      "description": "Authenticated account (User record id) that last corrected this record through Manual Entry / Edit Attendance. Audit only \u2014 it never replaces the account that performed an original punch."
    },
    "last_edited_by_name": {
      "type": "string",
      "description": "Display name of the account that last corrected this record (denormalized for the audit trail)"
    },
    "last_edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last manual correction (Manual Entry / Edit Attendance)"
    },
    "remarks": {
      "type": "string",
      "description": "Additional remarks"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft delete flag \u2014 deleted records are hidden from views but retained for history"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the record was soft-deleted"
    },
    "deleted_by": {
      "type": "string",
      "description": "Email of the user who soft-deleted this record"
    },
    "deletion_reason": {
      "type": "string",
      "description": "Reason for soft-deleting this record"
    }
  },
  "required": [
    "personnel_id",
    "attendance_date",
    "check_in_at",
    "status"
  ]
}