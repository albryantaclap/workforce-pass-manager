{
  "name": "InventoryItem",
  "type": "object",
  "properties": {
    "item_sn": {
      "type": "string",
      "description": "Unique item serial number (e.g. GSOQ-001)"
    },
    "item_name": {
      "type": "string",
      "description": "Item name / description"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measure (UOM) \u2014 e.g. NOS, MTR, SET"
    },
    "category": {
      "type": "string",
      "description": "Item category (sourced from InventoryLookup)"
    },
    "min_stock_level": {
      "type": "number",
      "default": 0,
      "description": "Minimum stock level \u2014 at or below this = Low Stock alert"
    },
    "bin_location": {
      "type": "string",
      "description": "Bin location for physical storage (e.g. BIN-A1)"
    },
    "rack_location": {
      "type": "string",
      "description": "Rack location for physical storage (e.g. RACK-03)"
    },
    "is_equipment": {
      "type": "boolean",
      "default": false,
      "description": "Whether this item is equipment/tool requiring TPC and calibration expiry tracking"
    },
    "equipment_serial_no": {
      "type": "string",
      "description": "Individual equipment serial number (for equipment/tools with individual serial numbers)"
    },
    "tpc_expiry": {
      "type": "string",
      "format": "date",
      "description": "TPC (Third Party Certification) expiry date (equipment/tools only)"
    },
    "calibration_expiry": {
      "type": "string",
      "format": "date",
      "description": "Calibration certificate expiry date (equipment/tools only)"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Archived items are hidden from active lists but retained for history. Items with transactions cannot be deleted, only archived."
    },
    "remarks": {
      "type": "string",
      "description": "Additional remarks"
    },
    "updated_by": {
      "type": "string",
      "description": "Email of user who last updated this item"
    }
  },
  "required": [
    "item_sn",
    "item_name",
    "unit"
  ]
}