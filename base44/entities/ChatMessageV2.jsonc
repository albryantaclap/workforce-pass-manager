{
  "name": "ChatMessageV2",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID of the conversation this message belongs to"
    },
    "sender_id": {
      "type": "string",
      "description": "User ID of sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of sender"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of sender"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of mentioned user emails"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of attached files"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "delivered",
        "seen"
      ],
      "default": "sent",
      "description": "Message delivery status"
    },
    "edited": {
      "type": "boolean",
      "default": false,
      "description": "Whether message was edited"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft delete flag"
    }
  },
  "required": [
    "conversation_id",
    "sender_id",
    "sender_email",
    "message"
  ]
}