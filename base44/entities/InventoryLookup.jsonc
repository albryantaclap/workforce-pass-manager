{
  "name": "InventoryLookup",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "item_category",
        "unit",
        "store",
        "site",
        "supplier"
      ],
      "description": "Lookup category for inventory module"
    },
    "value": {
      "type": "string",
      "description": "The lookup value (uppercase)"
    },
    "label": {
      "type": "string",
      "description": "Display label"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this lookup is active and available in dropdowns"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft delete flag"
    },
    "updated_by": {
      "type": "string",
      "description": "Email of user who last updated this lookup"
    }
  },
  "required": [
    "type",
    "value",
    "label"
  ]
}