{
  "name": "Lookup",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "company",
        "company_type",
        "location",
        "department",
        "rlic_status",
        "pid_status",
        "ftw_result",
        "training_status",
        "nationality"
      ],
      "description": "Lookup category"
    },
    "value": {
      "type": "string",
      "description": "The lookup value (uppercase)"
    },
    "label": {
      "type": "string",
      "description": "Display label"
    },
    "is_builtin": {
      "type": "boolean",
      "default": false,
      "description": "True if this record is a DB override for a built-in constant entry"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft delete flag \u2014 deleted entries are hidden from dropdowns but retained for history"
    },
    "deleted_by": {
      "type": "string",
      "description": "Email of user who soft-deleted this entry"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of soft deletion"
    },
    "updated_by": {
      "type": "string",
      "description": "Email of user who last updated this entry"
    }
  },
  "required": [
    "type",
    "value",
    "label"
  ]
}