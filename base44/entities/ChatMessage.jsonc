{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "User ID of sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of sender"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of sender"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of mentioned user emails"
    },
    "channel": {
      "type": "string",
      "default": "general",
      "description": "Channel name (general or dm_userId)"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft delete flag"
    },
    "edited": {
      "type": "boolean",
      "default": false,
      "description": "Whether message was edited"
    }
  },
  "required": [
    "sender_id",
    "message",
    "channel"
  ]
}