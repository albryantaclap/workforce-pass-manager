{
  "name": "Employee",
  "type": "object",
  "properties": {
    "sl_no": {
      "type": "number",
      "description": "Serial number"
    },
    "name": {
      "type": "string",
      "description": "Full name of employee"
    },
    "photo_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "position_application": {
      "type": "string",
      "description": "Position as per application"
    },
    "designation_org_chart": {
      "type": "string",
      "description": "Designation as per organizational chart"
    },
    "company": {
      "type": "string",
      "enum": [
        "GSO QATAR",
        "ITELLIGENT",
        "ANION",
        "SEA QUEEN",
        "LMV E AND I",
        "METAL WORLD",
        "ASMA",
        "FIT",
        "SPRAY CON",
        "EMKAN",
        "ENERTEC",
        "CRYSTAL",
        "MEGATRONICS (GSO)",
        "ENERSERVE (GSO)",
        "ENERTEC (GSO)",
        "NTC (GSO)",
        "MIR (GSO)",
        "ALTAF (GSO)",
        "SWAN GLOBAL (GSO)",
        "SIGEL (GSO)",
        "AL-RAMSHA (GSO)",
        "ALTHAF (GSO)",
        "ZEAL-IT"
      ],
      "description": "Company"
    },
    "company_type": {
      "type": "string",
      "enum": [
        "Main",
        "Sub-contractor",
        "GSO Supervision"
      ],
      "description": "Company type"
    },
    "nationality": {
      "type": "string",
      "description": "Nationality"
    },
    "religion": {
      "type": "string",
      "description": "Religion"
    },
    "current_location": {
      "type": "string",
      "enum": [
        "QATAR",
        "COMO CAMP",
        "OTHER"
      ],
      "description": "Current location"
    },
    "dir_indir": {
      "type": "string",
      "enum": [
        "DIR",
        "INDIR"
      ],
      "description": "Direct or Indirect"
    },
    "contact_details": {
      "type": "string",
      "description": "Contact phone/details"
    },
    "sponsor": {
      "type": "string",
      "description": "Sponsor"
    },
    "remarks": {
      "type": "string",
      "description": "Remarks"
    },
    "qid_no": {
      "type": "string",
      "description": "QID / Visa number (unique identifier)"
    },
    "qid_expiry": {
      "type": "string",
      "format": "date",
      "description": "QID expiration date"
    },
    "pp_no": {
      "type": "string",
      "description": "Passport number"
    },
    "pp_expiry": {
      "type": "string",
      "format": "date",
      "description": "Passport expiry date"
    },
    "visa_date_applied": {
      "type": "string",
      "format": "date",
      "description": "Visa date applied"
    },
    "visa_date_received": {
      "type": "string",
      "format": "date",
      "description": "Visa date received"
    },
    "visa_expiry": {
      "type": "string",
      "format": "date",
      "description": "Visa expiry date"
    },
    "ftw_medical_date": {
      "type": "string",
      "format": "date",
      "description": "FTW medical date"
    },
    "ftw_received_date": {
      "type": "string",
      "format": "date",
      "description": "FTW received from Al-Safa date"
    },
    "ftw_approval_request_date": {
      "type": "string",
      "format": "date",
      "description": "TR FTW approval request date"
    },
    "ftw_count_days": {
      "type": "number",
      "description": "FTW count days"
    },
    "ftw_approved_date": {
      "type": "string",
      "format": "date",
      "description": "TR FTW date approved"
    },
    "ftw_result": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "PENDING",
        "RE-ASSESS"
      ],
      "description": "FTW / Medical result"
    },
    "ftw_doctor": {
      "type": "string",
      "description": "Doctor name"
    },
    "ftw_mobile": {
      "type": "string",
      "description": "Mobile number"
    },
    "gate_pass_issue_date": {
      "type": "string",
      "format": "date",
      "description": "Gate pass issue date"
    },
    "gate_pass_received_date": {
      "type": "string",
      "format": "date",
      "description": "Gate pass received date"
    },
    "gate_pass_expiry": {
      "type": "string",
      "format": "date",
      "description": "Gate pass expiry date"
    },
    "staff_no": {
      "type": "string",
      "description": "Staff number / RLIC number"
    },
    "rlic_status": {
      "type": "string",
      "enum": [
        "VALID RLIC PASS",
        "EXPIRED RLIC PASS",
        "SOON TO EXPIRE",
        "NO RLIC PASS"
      ],
      "description": "RLIC pass status"
    },
    "pid_issue_date": {
      "type": "string",
      "format": "date",
      "description": "Project ID issue date"
    },
    "pid_expiry": {
      "type": "string",
      "format": "date",
      "description": "Project ID expiry date"
    },
    "pid": {
      "type": "string",
      "description": "Project ID number"
    },
    "pid_status": {
      "type": "string",
      "enum": [
        "VALID PID PASS",
        "EXPIRED PID PASS",
        "SOON TO EXPIRE",
        "NO PID PASS"
      ],
      "description": "Project ID status"
    },
    "pid_projected_date": {
      "type": "string",
      "format": "date",
      "description": "Projected PID date"
    },
    "training_date": {
      "type": "string",
      "format": "date",
      "description": "Training date"
    },
    "training_status": {
      "type": "string",
      "enum": [
        "DONE",
        "PENDING",
        "NOT REQUIRED"
      ],
      "description": "Training status"
    }
  },
  "required": [
    "name",
    "company"
  ]
}