{
  "name": "Employee",
  "type": "object",
  "properties": {
    "sl_no": {
      "type": "number",
      "description": "Serial number"
    },
    "name": {
      "type": "string",
      "description": "Full name of employee"
    },
    "photo_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "sharepoint_url": {
      "type": "string",
      "description": "SharePoint document folder URL"
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether the employee is active",
      "default": true
    },
    "personnel_status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive",
        "Demobilized"
      ],
      "default": "Active",
      "description": "Personnel status: Active, Inactive, or Demobilized"
    },
    "workforce_stage": {
      "type": "string",
      "description": "Workforce Stage \u2014 'Active on Site' (already working at the project site) or 'Onboarding' (still completing requirements before working at site). Empty/missing = Unassigned (not yet classified). Manually assigned; independent of personnel_status (Active/Inactive/Demobilized) and never derived from Medical, Gate Pass, Training, Project ID, Daily Attendance or COMO Camp status."
    },
    "status_effective_date": {
      "type": "string",
      "format": "date",
      "description": "Date the current status became effective"
    },
    "inactive_date": {
      "type": "string",
      "format": "date",
      "description": "Date personnel became inactive"
    },
    "last_working_date": {
      "type": "string",
      "format": "date",
      "description": "Last working date"
    },
    "status_reason": {
      "type": "string",
      "description": "Reason for status change (inactive/demobilized)"
    },
    "status_remarks": {
      "type": "string",
      "description": "Additional remarks on status change"
    },
    "status_changed_by": {
      "type": "string",
      "description": "Email of user who last changed the personnel status"
    },
    "status_changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last status change"
    },
    "demobilization_date": {
      "type": "string",
      "format": "date",
      "description": "Demobilization date (for Demobilized status)"
    },
    "demobilization_reason": {
      "type": "string",
      "description": "Reason for demobilization"
    },
    "is_manager": {
      "type": "boolean",
      "description": "Whether this person can be assigned as a manager",
      "default": false
    },
    "assigned_manager_id": {
      "type": "string",
      "description": "ID of the assigned manager (references another Employee)"
    },
    "assigned_manager_name": {
      "type": "string",
      "description": "Name of the assigned manager (denormalized)"
    },
    "position_application": {
      "type": "string",
      "description": "Position as per application"
    },
    "designation_org_chart": {
      "type": "string",
      "description": "Designation as per organizational chart"
    },
    "department": {
      "type": "string",
      "enum": [
        "Electrical",
        "Mechanical",
        "Civil",
        "Services"
      ],
      "description": "Department"
    },
    "company": {
      "type": "string",
      "enum": [
        "GSO QATAR",
        "ITELLIGENT",
        "ANION",
        "SEA QUEEN",
        "LMV E AND I",
        "METAL WORLD",
        "ASMA",
        "FIT",
        "SPRAY CON",
        "EMKAN",
        "ENERTEC",
        "CRYSTAL",
        "MEGATRONICS (GSO)",
        "ENERSERVE (GSO)",
        "ENERTEC (GSO)",
        "NTC (GSO)",
        "MIR (GSO)",
        "SWAN GLOBAL (GSO)",
        "SIGEL (GSO)",
        "AL-RAMSHA (GSO)",
        "ALTHAF (GSO)",
        "ZEAL-IT"
      ],
      "description": "Company"
    },
    "company_type": {
      "type": "string",
      "enum": [
        "Main",
        "Sub-contractor",
        "GSO Supervision"
      ],
      "description": "Company type"
    },
    "nationality": {
      "type": "string",
      "description": "Nationality"
    },
    "religion": {
      "type": "string",
      "description": "Religion"
    },
    "current_location": {
      "type": "string",
      "description": "Current location (sourced dynamically from Lookup Management \u2192 Location)"
    },
    "dir_indir": {
      "type": "string",
      "enum": [
        "DIR",
        "INDIR"
      ],
      "description": "Direct or Indirect"
    },
    "work_location": {
      "type": "string",
      "description": "Work location (synced to the Approved List)"
    },
    "contact_details": {
      "type": "string",
      "description": "Contact phone/details"
    },
    "sponsor": {
      "type": "string",
      "description": "Sponsor"
    },
    "remarks": {
      "type": "string",
      "description": "Remarks"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "description": "Approval date used to qualify for the Approved List"
    },
    "approval_comments": {
      "type": "string",
      "description": "Approval comments synced to the Approved List"
    },
    "qid_no": {
      "type": "string",
      "description": "QID / Visa number (unique identifier)"
    },
    "qid_expiry": {
      "type": "string",
      "format": "date",
      "description": "QID expiration date"
    },
    "pp_no": {
      "type": "string",
      "description": "Passport number"
    },
    "pp_expiry": {
      "type": "string",
      "format": "date",
      "description": "Passport expiry date"
    },
    "visa_date_applied": {
      "type": "string",
      "format": "date",
      "description": "Visa date applied"
    },
    "visa_date_received": {
      "type": "string",
      "format": "date",
      "description": "Visa date received"
    },
    "visa_expiry": {
      "type": "string",
      "format": "date",
      "description": "Visa expiry date"
    },
    "ftw_medical_date": {
      "type": "string",
      "format": "date",
      "description": "FTW medical date"
    },
    "ftw_received_date": {
      "type": "string",
      "format": "date",
      "description": "FTW received from Al-Safa date"
    },
    "ftw_approval_request_date": {
      "type": "string",
      "format": "date",
      "description": "TR FTW approval request date"
    },
    "ftw_count_days": {
      "type": "number",
      "description": "FTW count days"
    },
    "ftw_approved_date": {
      "type": "string",
      "format": "date",
      "description": "TR FTW date approved"
    },
    "ftw_result": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "WAITING TR APPROVAL",
        "RE-ASSESS"
      ],
      "description": "FTW / Medical result"
    },
    "ftw_reassess_date": {
      "type": "string",
      "format": "date",
      "description": "Re-Assess date"
    },
    "ftw_remarks": {
      "type": "string",
      "description": "Medical remarks"
    },
    "ftw_doctor": {
      "type": "string",
      "description": "Doctor name"
    },
    "ftw_mobile": {
      "type": "string",
      "description": "Mobile number"
    },
    "gate_pass_issue_date": {
      "type": "string",
      "format": "date",
      "description": "Gate pass issue date"
    },
    "gate_pass_received_date": {
      "type": "string",
      "format": "date",
      "description": "Gate pass received date"
    },
    "gate_pass_expiry": {
      "type": "string",
      "format": "date",
      "description": "Gate pass expiry date"
    },
    "staff_no": {
      "type": "string",
      "description": "Staff number / RLIC number"
    },
    "rlic_status": {
      "type": "string",
      "enum": [
        "VALID RLIC PASS",
        "EXPIRED RLIC PASS",
        "SOON TO EXPIRE",
        "NO RLIC PASS"
      ],
      "description": "RLIC pass status"
    },
    "training_date_scheduled": {
      "type": "string",
      "format": "date",
      "description": "Training date scheduled"
    },
    "training_date_start": {
      "type": "string",
      "format": "date",
      "description": "Training date started"
    },
    "training_date_end": {
      "type": "string",
      "format": "date",
      "description": "Training date end"
    },
    "training_date": {
      "type": "string",
      "format": "date",
      "description": "Training date (legacy)"
    },
    "training_status": {
      "type": "string",
      "enum": [
        "DONE",
        "PENDING",
        "NOT REQUIRED",
        "SCHEDULED",
        "ON-GOING",
        "TO BE SCHEDULED",
        "ABSENT"
      ],
      "description": "Training status"
    },
    "pid_issue_date": {
      "type": "string",
      "format": "date",
      "description": "Project ID issue date"
    },
    "pid_expiry": {
      "type": "string",
      "format": "date",
      "description": "Project ID expiry date"
    },
    "pid": {
      "type": "string",
      "description": "Project ID number"
    },
    "pid_status": {
      "type": "string",
      "enum": [
        "VALID PID PASS",
        "EXPIRED PID PASS",
        "SOON TO EXPIRE",
        "NO PID PASS"
      ],
      "description": "Project ID status"
    },
    "pid_projected_date": {
      "type": "string",
      "format": "date",
      "description": "Projected PID date"
    }
  },
  "required": [
    "name",
    "company"
  ]
}