{
  "name": "AttendancePunch",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string",
      "description": "Linked Employee record ID (Master List identity)"
    },
    "employee_name": {
      "type": "string",
      "description": "Employee full name (denormalized for display only)"
    },
    "company": {
      "type": "string",
      "description": "Employee company (denormalized for display only)"
    },
    "attendance_date": {
      "type": "string",
      "format": "date",
      "description": "The attendance date (YYYY-MM-DD) determined by shift/session date, not calendar midnight"
    },
    "punch_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of the punch"
    },
    "punch_type": {
      "type": "string",
      "enum": [
        "IN",
        "OUT"
      ],
      "description": "Punch direction: IN (clock in) or OUT (clock out)"
    },
    "punch_sequence": {
      "type": "number",
      "description": "Sequence within the day: 1=First In, 2=First Out, 3=Second In, 4=Final Out"
    },
    "source": {
      "type": "string",
      "enum": [
        "Manual",
        "COMO Camp",
        "Employee Portal",
        "ID Card Scanner",
        "Biometric Device",
        "Admin Entry",
        "Imported",
        "API"
      ],
      "default": "Admin Entry",
      "description": "Where the punch originated"
    },
    "location": {
      "type": "string",
      "description": "Branch/location where the punch was recorded"
    },
    "device_id": {
      "type": "string",
      "description": "Device identifier for biometric/scanner punches"
    },
    "work_location_id": {
      "type": "string",
      "description": "Linked WorkLocation record ID the punch was recorded at (empty when no branch was selected)"
    },
    "work_location_code": {
      "type": "string",
      "description": "Work location code captured at the time of the punch (denormalized, historical)"
    },
    "work_location_name": {
      "type": "string",
      "description": "Work location name captured at the time of the punch (denormalized, historical)"
    },
    "latitude": {
      "type": "number",
      "description": "GPS latitude captured with the punch (empty when no GPS was available)"
    },
    "longitude": {
      "type": "number",
      "description": "GPS longitude captured with the punch (empty when no GPS was available)"
    },
    "gps_accuracy_m": {
      "type": "number",
      "description": "Reported GPS accuracy in meters"
    },
    "distance_m": {
      "type": "number",
      "description": "Distance in meters between the punch GPS position and the work location coordinates"
    },
    "geofence_status": {
      "type": "string",
      "enum": [
        "Within Geofence",
        "Outside Geofence",
        "No GPS",
        "Not Enforced"
      ],
      "description": "Geofence result recorded with the punch"
    },
    "location_verified": {
      "type": "boolean",
      "description": "True when the punch was accepted with the work location verified against its geofence"
    },
    "created_by": {
      "type": "string",
      "description": "Email of the user who created the punch"
    },
    "created_by_user_id": {
      "type": "string",
      "description": "Authenticated account (User record id) that created the punch \u2014 the permanent reference for who scanned/entered it"
    },
    "created_by_name": {
      "type": "string",
      "description": "Display name of the user who created the punch"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft delete flag"
    }
  },
  "required": [
    "personnel_id",
    "attendance_date",
    "punch_timestamp",
    "punch_type"
  ]
}